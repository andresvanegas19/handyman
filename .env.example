NEXT_PUBLIC_CONVEX_URL=
# Optional for custom deployments; standard .convex.cloud URLs derive this automatically.
NEXT_PUBLIC_CONVEX_SITE_URL=
# Enable the new image + written prompt workflow after configuring its backend.
NEXT_PUBLIC_VISUAL_REPAIR_ENABLED=false
# Set the following in the Convex dashboard, not in client code:
# JWT_PRIVATE_KEY and JWKS are generated by: npx @convex-dev/auth
# SITE_URL=http://localhost:3000
# ADMIN_SUBJECTS=comma-separated anonymous Convex user IDs (optional editorial access)
# APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# OPENAI_API_KEY=
# OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# AI_DAILY_LIMIT=100
# TRIPO_API_KEY=
# Create a server API key at https://developers.tripo3d.ai/en/keys.
# Choose a supported image-to-model version, for example v3.1-20260211.
# TRIPO_MODEL_VERSION=
# TRIPO_DAILY_LIMIT=0
# TRIPO_ASSET_HOSTS=tripo3d.ai,tripo3d.com
# Automatic visual repair pipeline (server-side opt-in; legacy flows remain available).
# VISUAL_REPAIR_ENABLED=true
# FIRECRAWL_API_KEY=
# FIRECRAWL_DAILY_LIMIT=0
# OPENROUTER_API_KEY=
# Select explicit, supported model IDs from https://openrouter.ai/models.
# Each stage picks the lowest estimated-cost capable model in its comma-separated allowlist.
# General-purpose text + vision model verified with the required zero-retention routing.
# Add alternatives only after confirming their provider supports privacy and strict output.
# Unconfigured code defaults to Qwen alone, which may have no eligible zero-retention endpoint.
# OPENROUTER_RECOGNITION_MODELS=openai/gpt-4o-mini
# OPENROUTER_PLANNING_MODELS=openai/gpt-4o-mini
# OPENROUTER_MAPPING_MODELS=openai/gpt-4o-mini
# Optional pin: overrides cheapest-model selection and must be in the planning allowlist.
# Leave unset to cost-rank planning models.
# OPENROUTER_PLANNING_MODEL=qwen/qwen3.8-flash
# Estimated cost guard only, not an actual-dollar billing guarantee.
# OPENROUTER_MAX_ESTIMATED_COST_USD=0.05
# OPENROUTER_IMAGE_TOKEN_ESTIMATE=4096
# OPENROUTER_PROVIDER_ALLOWLIST=
# The visual flow requires zero-data-retention providers; no privacy fallback is used.
# Visual Tripo downloads use exact hosts (cdn.tripo3d.ai is included automatically).
# TRIPO_ASSET_HOSTS=cdn.tripo3d.ai
