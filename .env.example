NEXT_PUBLIC_CONVEX_URL=
# Optional for custom deployments; standard .convex.cloud URLs derive this automatically.
NEXT_PUBLIC_CONVEX_SITE_URL=
# Enable the new image + written prompt workflow after configuring its backend.
NEXT_PUBLIC_VISUAL_REPAIR_ENABLED=false
# Set the following in the Convex dashboard, not in client code:
# JWT_PRIVATE_KEY and JWKS are generated by: npx @convex-dev/auth
# SITE_URL=http://localhost:3000
# ADMIN_SUBJECTS=comma-separated anonymous Convex user IDs (optional editorial access)
# APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# OPENAI_API_KEY=
# OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# AI_DAILY_LIMIT=100
# TRIPO_API_KEY=
# Create a server API key at https://developers.tripo3d.ai/en/keys.
# Choose a supported image-to-model version, for example v3.1-20260211.
# TRIPO_MODEL_VERSION=
# TRIPO_DAILY_LIMIT=0
# TRIPO_ASSET_HOSTS=tripo3d.ai,tripo3d.com
# Automatic visual repair pipeline (server-side opt-in; legacy flows remain available).
# VISUAL_REPAIR_ENABLED=true
# FIRECRAWL_API_KEY=
# OPENROUTER_API_KEY=
# Select explicit, supported model IDs from https://openrouter.ai/models.
# OPENROUTER_RECOGNITION_MODELS=qwen/qwen3.8-flash
# OPENROUTER_PLANNING_MODELS=qwen/qwen3.8-flash
# OPENROUTER_MAPPING_MODELS=qwen/qwen3.8-flash
